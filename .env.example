# Copie este arquivo para .env (uso local) e preencha os valores.
# Em producao (GitHub Actions) essas mesmas chaves devem ser cadastradas
# como Secrets do repositorio (Settings > Secrets and variables > Actions).

# Groq (LLM gratuito) - crie uma chave em https://console.groq.com/keys
GROQ_API_KEY=

# App do TikTok Developer Portal (https://developers.tiktok.com/apps)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Obtido rodando `python -m src.oauth_setup` uma unica vez (ver README)
TIKTOK_REFRESH_TOKEN=

# Necessario apenas para o bot conseguir ATUALIZAR sozinho o secret
# TIKTOK_REFRESH_TOKEN no GitHub apos cada execucao (o token rotaciona).
# Personal Access Token (classic) com escopo "repo".
GH_PAT=
GH_REPOSITORY=seu-usuario/tiktok-ai-bot
